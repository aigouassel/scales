{
  "name": "scales",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @scales/web dev",
    "build": "yarn workspace @scales/web build",
    "preview": "yarn workspace @scales/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
